# --- Invoice Ninja v5 -------------------------------------------------------
NINJA_URL=https://invoice.example.com
# Einstellungen -> Account-Verwaltung -> API-Tokens
NINJA_TOKEN=

# --- Login --------------------------------------------------------------------
APP_USER=admin
# Wird von "python3 set_password.py" gesetzt – nicht von Hand eintragen.
APP_PASSWORD_HASH=
# Zufallswert, min. 32 Zeichen: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Nur für lokale Tests ohne HTTPS auf 0 setzen
COOKIE_SECURE=1

# --- Beleg-Auslese ------------------------------------------------------------
# tesseract (lokal, keine Daten verlassen den Server) oder none
EXTRACTOR=tesseract
# Eigene Firma/Namen (Rechnungsempfänger), kommagetrennt – werden nie als Lieferant vorgeschlagen
OWN_NAMES=

# --- Container ----------------------------------------------------------------
DATA_DIR=/data/belege
# UID/GID des Host-Users, dem ./data gehört (Ausgabe von: id -u / id -g)
APP_UID=1000
APP_GID=1000
